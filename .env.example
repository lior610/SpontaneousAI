# External PostgreSQL database
POSTGRES_HOST=db_ip
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
POSTGRES_DB=postgres
POSTGRES_ATTRACTIONS_DB=attractions
POSTGRES_USERS_DB=client_info

# OpenTripMap API (free key from https://dev.opentripmap.org)
OPENTRIPMAP_API_KEY=api_key_here

# Google Gemini — used by the API to infer how long a visitor should stay at an
# attraction (auto-detects "didn't like" from short dwell times).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# If a visitor stays less than this fraction of the recommended duration, mark as disliked.
STAY_DISLIKE_RATIO=0.5

# Food Intercept — suggests a food break instead of a regular attraction when the user is maybe hungry
# Set to "false" to disable the feature entirely.
FOOD_INTERCEPT_ENABLED=true
# Cooldown (ms) after the user dismisses a food suggestion before offering another (Default 1h)
FOOD_COOLDOWN_MS=3600000
# Number of activities since last food before a break is considered
FOOD_ACTIVITY_THRESHOLD=2
# Hours since last food before a break is considered
FOOD_HOURS_THRESHOLD=3.5

# API server
PORT=3000
# How long (ms) the API caches a batch of engine recommendations per trip. Default 30 min.
RECOMMENDATION_CACHE_TTL_MS=1800000
# Postgres connection timeout (ms) for the API's connection pools.
PG_CONNECTION_TIMEOUT_MS=15000

# Engine URL (for API to reach Attraction Engine)
# Use "localhost" when running services locally; use "engine" when using docker-compose
ENGINE_HOST=localhost
ENGINE_PORT=8000

# EMA smoothing factor for real-time preference updates (0-1): higher reacts faster to likes.
EMA_ALPHA=0.3

RANKING_WEIGHT_SEMANTIC=0.35
RANKING_WEIGHT_HOURS=0.10
RANKING_WEIGHT_DISTANCE=0.20
RANKING_WEIGHT_BUDGET=0.10
RANKING_WEIGHT_POPULARITY=0.20
RANKING_WEIGHT_DIVERSITY=0.15

# Google Maps API key for the interactive map on the trip page
# Get one at https://console.cloud.google.com/apis/credentials (enable Maps JavaScript API)
VITE_GOOGLE_MAPS_API_KEY=

# Browser GPS: "on" to fetch user's position on page load (used for map display
# and for auto-detecting arrival/departure at an attraction)
VITE_GPS_ENABLED=off

# Background tracking: "on" to periodically sync user's GPS position to backend every 5 min
VITE_BACKGROUND_TRACKING=off

# Ranking Penalties
RANKING_CLUSTER_PENALTY=1.0

# Preference Vector Dynamic Weights
VECTOR_WEIGHT_SETUP_BASE=0.80
VECTOR_WEIGHT_SHIFT_PER_LIKE=0.12
VECTOR_WEIGHT_MAX_REALTIME=0.60

# PreferenceComposer — trip-setup blend: category embeddings vs qualifier text (ideally sum to 1.0)
PREF_WEIGHT_TRIP_SETUP_CATEGORIES=0.8
PREF_WEIGHT_TRIP_SETUP_QUALIFIERS=0.2

# ---------------------------------------------------------------------------
# Popular Trips + Companion Suggestions ("because you liked X, you might also like Y")
# ---------------------------------------------------------------------------
# Runtime (engine): minimum cosine similarity between the user's preference vector
# and a popular trip's persona for the suggestion to trigger.
COMPANION_SIM_THRESHOLD=0.45
# Max companion suggestions offered per trip (anti-nag; in-memory per engine process).
COMPANION_MAX_PER_TRIP=3
# Minimum number of likes between two suggestions on the same trip (anti-nag).
COMPANION_COOLDOWN_LIKES=1
# Fallback walking radius (km) when a trip has no max_walking_distance set.
COMPANION_DEFAULT_MAX_WALK_KM=2.0

# Offline pool generation (data-pipeline/scripts/generate_popular_trips.py; reuses GEMINI_API_KEY/GEMINI_MODEL)
POPULAR_TRIPS_PER_PERSONA=10
POPULAR_TRIP_MIN_STOPS=4
POPULAR_TRIP_MAX_STOPS=6
# Max attractions per city offered to the LLM when composing routes.
POPULAR_TRIPS_CATALOG_LIMIT=150
# 1 = top-up mode: keep existing trips and only generate for personas that have
# fewer than POPULAR_TRIPS_PER_PERSONA trips (no delete). Empty = full regenerate.
POPULAR_TRIPS_FILL_MISSING=
# Optional: restrict generation to a single location slug (e.g. london). Empty = all.
LOCATION_SLUG=

# ---------------------------------------------------------------------------
# "Walk a bit further?" — when nothing is left within the trip's walking radius,
# the app offers to widen it (persisted to trips.max_walking_distance) instead of
# ending the trip. (api/src/controllers/tripsController.js: expandWalkingRange)
# ---------------------------------------------------------------------------
# Kilometers added to the radius each time the user agrees.
WALK_EXPAND_STEP_KM=1.0
# Hard ceiling (km) the radius can grow to (DB column caps at 99.99).
WALK_MAX_KM=20
